// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}


/// Публикация в блоге.
/// Является основной сущностью системы.
model Post {
  id          Int      @id @default(autoincrement())
  
  /// Человекочитаемый URL. 
  /// Индексируется для быстрого поиска, строго уникален.
  slug        String   @unique

  title       String
  
  /// Краткое превью статьи для вывода в карточках на главной странице.
  /// Может быть пустым (null), если автор не заполнил SEO-блок.
  description String?

  content     String?

  /// Ссылка на картинку-обложку
  image       String?

  /// ID автора статьи, необязателен, чтобы при удалении - не следовало удалять посты
  authorId    Int?

  /// Связь с таблицей Users. 
  author      User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)

  createdAt   DateTime @default(now())

  /// Автоматически обновляется при любом изменении записи
  updatedAt   DateTime @updatedAt

  @@map("posts")
}

/// Пользователь системы (автор публикаций).
model User {
  id        Int      @id @default(autoincrement())
  
  /// Уникальный логин для входа
  email     String   @unique
  
  /// Хэш пароля
  passwordHash  String   
  
  /// Отображаемое имя на сайте
  name      String
  
  createdAt DateTime @default(now())
  
  /// Обратная связь: список всех постов, написанных этим пользователем.
  posts     Post[]

  @@map("users")
}